$f7f1de8e150b45e2$exports = JSON.parse('{"nav":{"services":"Services","about":"About","clients":"Clients"},"footer":{"home":"Home","privacyPolicy":"Privacy Policy"},"cta":{"freePpcReview":"Free PPC audit"},"hero":{"title":"More Leads, Sales & Revenue from Google Ads","subtitle":"Specialist PPC management focused on lead quality, CPA, ROAS, sales and revenue across Search, Performance Max, Shopping and paid social.","cta":"Free PPC audit","note":"No obligation. We\u2019ll show you what we would improve."},"options":{"title":"The goal is not simply to manage PPC \u2014 it is to improve the business result","description":"As ad spend grows, small weaknesses in measurement, campaign structure or bidding can become expensive. What matters is having someone who can consistently identify wasted spend, improve conversion quality and turn more of the budget into customers.","question":"Which PPC setup fits your business?","option1":{"label":"option 1","title":"Manage PPC in-house","intro":"Maximum control and minimal external cost \u2014 if your team has the time and specialist PPC expertise.","pro1":{"title":"Full control","text":"- You set the priorities, budgets and pace of decision-making."},"con1":{"title":"A steep expertise curve","text":"- Google Ads, Performance Max and measurement evolve quickly; weak signals or structure can quietly increase CPA."},"con2":{"title":"A serious time commitment","text":"- Search terms, testing, feeds, tracking and optimisation require ongoing attention, not a one-off setup."}},"option2":{"label":"option 2","title":"Work with a full-service agency","intro":"Convenient when you want one partner covering several marketing disciplines.","pro1":{"title":"One partner across channels","text":"- Fewer suppliers and simpler coordination across your wider marketing activity."},"con1":{"title":"PPC is one of many services","text":"- Attention is shared across PPC, SEO, creative, content and other services."},"con2":{"title":"Depth of PPC expertise can vary","text":"- For complex accounts, it matters who makes the decisions and how closely they work with conversion and revenue data."}},"option3":{"label":"option 3","title":"Hire an in-house PPC specialist","intro":"A strong model when your business needs a specialist embedded in the team every day.","pro1":{"title":"Deep business knowledge","text":"- An in-house specialist works closely with your team and can develop a detailed understanding of the product, processes and priorities."},"con1":{"title":"Higher fixed cost","text":"- Salary, taxes, training and tools create a fixed cost regardless of how much specialist work is needed."},"con2":{"title":"Single-person dependency","text":"- Performance depends heavily on one person\'s experience, capacity and ability to challenge their own assumptions."}}},"services":{"kicker":"Specialist PPC agency","title":"Google Ads & paid media managed by specialists","description":"We focus on paid media, measurement and conversions. We identify wasted spend, improve the signals used by bidding algorithms and scale the campaigns that create real commercial value.","cta":"Review my account"},"about":{"founder":{"name":"Boris Kuzmenyuk","role":"Founder & Senior PPC Manager","quote1":"I judge PPC by the quality of the leads, sales and revenue it creates \u2014 not by how good the dashboard looks.","quote2":"The job is to find where budget is being lost, fix the measurement and scale what genuinely works."},"title":"Your account stays with experienced PPC specialists \u2014 from strategy to optimisation","description":"The people making the strategic decisions stay involved in the account. You know what is changing, why it is changing and how it is expected to improve CPA, ROAS, lead quality and revenue.","point1":"Experienced PPC specialists stay directly involved in strategy, measurement and key account decisions.","point2":"We optimise around CPA, ROAS, lead quality, sales and revenue \u2014 not isolated vanity metrics.","point3":"GA4, Google Tag Manager, Consent Mode and conversion tracking are treated as one measurement system for paid media.","point4":"We work across Search, Performance Max, Google Shopping, Microsoft Advertising and paid social.","point5":"You can see what we change, why we change it and what result each decision is intended to improve.","point6":"Our Google Ads expertise is supported by current platform certifications.","point7":"We do not automatically hand your account to junior specialists after the engagement begins."},"boosts":{"title":"What we improve to turn more ad spend into customers","subtitle":"We prioritise the parts of the account that can materially affect lead quality, CPA, ROAS, sales and revenue.","item1":{"title":"Wasted spend","text":"We identify campaigns, search terms, audiences, placements and segments that consume budget without enough commercial return."},"item2":{"title":"Conversion quality","text":"We review GA4, Google Tag Manager and primary conversions so Smart Bidding and Performance Max learn from the right signals."},"item3":{"title":"Campaign structure","text":"We assess budgets, bidding, keywords, ads, feeds and campaign interaction to remove structural limits on performance."},"item4":{"title":"Lead quality","text":"We look beyond form fills and calls to the enquiries that have a realistic chance of becoming customers."},"item5":{"title":"High-impact tests","text":"We prioritise hypotheses that can materially improve the business result instead of filling the account with low-impact activity."},"item6":{"title":"Scaling","text":"We increase investment where the data supports it \u2014 not simply because an ad platform recommends a higher budget."}},"start":{"title":"Start with a free PPC audit","subtitle":"We review the account, show you the biggest opportunities and give you a clear order of priorities. Then you decide whether working together makes sense.","step1":{"label":"step 01","title":"We review the account and measurement","text":"We analyse spend, Search, Performance Max, Shopping, campaign structure, conversions and measurement."},"step2":{"label":"step 02","title":"You get a prioritised action plan","text":"We show where performance is being lost, what should be fixed first and which changes have the strongest business case."},"step3":{"label":"step 03","title":"We decide what happens next","text":"If we see meaningful upside and a strong fit, we build the next-step plan. If not, you still leave with useful findings."},"cta":"Free PPC audit"},"whatWeDo":{"title":"Google Ads, Performance Max, Shopping & Paid Social","subtitle":"One performance framework across channels: reliable measurement, controlled spend and optimisation around qualified leads, sales and revenue.","tool":{"googleAds":"Google Ads","facebookAds":"Facebook Ads","googleShopping":"Google Shopping","bingAds":"Microsoft Advertising","linkedinAds":"LinkedIn Ads","instagramAds":"Instagram Ads"}},"work":{"title":"For businesses that measure PPC by leads, sales and revenue","subtitle":"E-commerce, lead generation, B2B and international advertising accounts.","size":{"title":"Scale","text":"We work with both focused growth accounts and complex multi-market PPC programmes."},"location":{"title":"Geography","text":"We work with businesses in Ukraine and international markets, with a particular focus on Europe and English-speaking markets."},"credibility":{"title":"Partnership","text":"We do our best work when advertising data can be connected with meaningful business outcomes rather than platform metrics alone."}},"clients":{"title":"Clients and projects we\'ve worked with","placeholder":{"alt":"Photon Digital client logo"}},"contact":{"title":"See where your Google Ads can generate more qualified leads and revenue","bullet1":"Where budget is being spent without enough commercial return","bullet2":"Whether GA4, GTM and conversion tracking are giving Google the right signals","bullet3":"What is driving CPA, ROAS and lead quality","bullet4":"Which changes should come first \u2014 before you increase spend","form":{"nameLabel":"Name","namePlaceholder":"Your name","emailLabel":"Email","emailPlaceholder":"Your email","messageLabel":"Message","messagePlaceholder":"Website, ad spend or a short note about your goal (optional)","cta":"Request free audit"}},"case-studies":{"title":"Google Ads & PPC Case Studies: Leads, ROAS & Revenue","common":{"challenge":"Challenge:","perMonth":"/mo"},"cards":{"aromaDiffuser":{"category":"E-commerce","title":"Google Ads for E-commerce: Scaling Across EU Markets","challenge":"High cost per purchase and unstable ROAS while scaling across multiple EU markets","description":"We restructured campaigns, improved product feeds and refined Smart Bidding to stabilise ROAS while scaling across several EU markets.","metrics":{"roas":{"label":"ROAS Improvement"},"cpa":{"label":"CPA Reduction"},"growth":{"label":"Revenue Growth"}}},"autoParts":{"category":"Automotive & E-commerce","title":"Google Shopping & PPC for an Auto Parts Retailer","challenge":"Low conversion rate and poor campaign structure across multiple product categories","description":"We rebuilt the account structure and redirected budget towards product categories and segments with stronger commercial performance.","metrics":{"sales":{"label":"Sales Increase"},"roas":{"label":"ROAS"},"growth":{"label":"Revenue Growth"}}},"psychologist":{"category":"Healthcare & Services","title":"Google Ads for a Private Practice in Germany","challenge":"Expensive leads and low booking rate from Google Ads","description":"We reviewed the funnel, targeting and landing pages to reduce CPL and increase the share of enquiries with genuine booking intent.","metrics":{"costPerLead":{"label":"Cost per Lead"},"monthlyLeads":{"label":"Monthly Leads"},"growth":{"label":"Lead Growth"}}},"logistics":{"category":"Logistics & B2B","title":"B2B Google Ads for a European Logistics Company","challenge":"High cost per lead and low-quality B2B inquiries","description":"We tightened commercial intent, filtered irrelevant traffic and focused budget on search demand more likely to produce qualified B2B enquiries.","metrics":{"costPerLead":{"label":"Cost per Lead"},"qualifiedLeads":{"label":"Qualified Leads"},"growth":{"label":"Lead Growth"}}}}},"pricing":{"title":"PPC management matched to account complexity","subtitle":"The right level of management depends on campaign complexity, markets, budget, measurement and the pace of testing and scaling.","common":{"perMonth":"/ month","primaryCta":"Discuss my account","secondaryCta":"Contact us"},"cards":{"starter":{"title":"Starter","features":["Setup and management of 1\u20132 campaigns (Search / Performance Max)","Keyword, search term and negative keyword management","Core GA4 & Google Tag Manager setup","PPC strategy aligned with business goals"],"hours":"For focused accounts with a simple campaign structure","reporting":"Senior-led optimisation + monthly performance review"},"growth":{"badge":"\uD83D\uDD25 MOST POPULAR","title":"Growth","features":["Everything in Starter","3\u20135 campaigns (Search + Display / Shopping)","Remarketing and audience signals","Ongoing ad and hypothesis testing"],"hours":"For growing accounts across several campaign types","reporting":"Weekly optimisation + regular performance review"},"business":{"title":"Business","features":["Everything in Growth","Advanced Performance Max management","Full advertising account audit","Scaling and budget allocation strategy"],"hours":"For more complex accounts with active scaling","reporting":"Multiple optimisation cycles per week + strategic recommendations"},"enterprise":{"title":"Premium / Enterprise","price":"from $2500","features":["Multi-channel paid media (Search + Display + Shopping + YouTube)","Dedicated senior PPC lead","End-to-end ROI / CPA / ROAS and conversion-quality analysis","Custom strategy for complex or multi-market accounts"],"hours":"For complex international paid media accounts","reporting":"Continuous monitoring + regular strategic reviews"}}},"languages":{"ua":"Ukrainian","gb":"English"},"privacyPolicy":{"slug":"privacy-policy","title":"Privacy & Cookie Policy","lastUpdated":"25 August 2026","language":"en","controller":{"legalName":"\u0424\u041E\u041F \u041A\u0443\u0437\u044C\u043C\u0435\u043D\u044E\u043A \u0411\u043E\u0440\u0438\u0441 \u041E\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u0438\u0447","registryRecord":"2011600000000096423","registrationDate":"2026-08-17","registeredAddress":"\u0423\u043A\u0440\u0430\u0457\u043D\u0430, 21007, \u0412\u0456\u043D\u043D\u0438\u0446\u044C\u043A\u0430 \u043E\u0431\u043B., \u0412\u0456\u043D\u043D\u0438\u0446\u044C\u043A\u0438\u0439 \u0440-\u043D, \u043C. \u0412\u0456\u043D\u043D\u0438\u0446\u044F, \u0432\u0443\u043B. \u0421\u0442\u0440\u0456\u043B\u0435\u0446\u044C\u043A\u0430, \u0431\u0443\u0434. 21","website":"https://photon-digital.com/","email":"info@photon-digital.com","phone":"+38 (068) 708-32-41"},"contentHtml":"<article class=\\"privacy-policy\\" lang=\\"en\\">\\n<h1>PRIVACY &amp; COOKIE POLICY</h1>\\n<p><strong>Last updated: 25 August 2026</strong></p>\\n<p>This Policy explains how Photon Digital processes personal data when you use the website, contact us, book a meeting, or interact with us as a client. It also describes the use of cookies, Cookiebot, Google Consent Mode v2 and Calendly.</p>\\n<h2>1. Who we are and who controls the data</h2>\\n<p>The website https://photon-digital.com/ and the Photon Digital brand are operated by Ukrainian sole proprietor (FOP) \u041A\u0443\u0437\u044C\u043C\u0435\u043D\u044E\u043A \u0411\u043E\u0440\u0438\u0441 \u041E\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u0438\u0447 (the \u201CController\u201D, \u201CPhoton Digital\u201D, \u201Cwe\u201D, \u201Cus\u201D).</p>\\n<p>Ukrainian Unified State Register record No. 2011600000000096423, registered on 17 August 2026.</p>\\n<p>Registered address: 21 Striletska Street, Vinnytsia, Vinnytsia District, Vinnytsia Region, 21007, Ukraine.</p>\\n<p>Privacy contact: info@photon-digital.com. Website: https://photon-digital.com/. Phone: +38 (068) 708-32-41.</p>\\n<p>Photon Digital is the controller for personal data used to operate its own website, handle enquiries, enter into and perform contracts, manage client relationships and comply with legal obligations.</p>\\n<p>When we access or process personal data in a client\u2019s advertising, analytics, CRM or other systems solely on the client\u2019s documented instructions, Photon Digital may act as a processor/service provider and the client remains the controller. Those activities should be governed by the relevant services agreement and, where required, a Data Processing Agreement (DPA).</p>\\n\\n<h2>2. Scope of this Policy</h2>\\n<p>This Policy applies to website visitors, people who submit a form or email us, people who book a meeting, prospective and current clients, and other business contacts.</p>\\n<p>It describes processing performed by Photon Digital for its own purposes. Where we process data on behalf of a client, the client\u2019s instructions and the applicable contract primarily govern that processing.</p>\\n\\n<h2>3. Personal data we may collect</h2>\\n\\n<h2>3.1. Data you provide directly</h2>\\n<p>through the website form: your name, email address, message and any additional information you choose to include;</p>\\n<p>when booking through Calendly: your name, email address, selected date and time, time zone, booking-form answers and other information you voluntarily provide;</p>\\n<p>in correspondence: contact details, message content and attachments;</p>\\n<p>during a client relationship: name, role, company, contact, contractual and billing/accounting details, project information, and access details for advertising or analytics systems to the extent necessary to provide the services.</p>\\n\\n<h2>3.2. Technical and analytics data</h2>\\n<p>IP address, approximate location, browser and version, device, operating system, language, URL and referrer, date/time of requests and technical security logs;</p>\\n<p>page views and interactions, cookie/local-storage identifiers, advertising identifiers or click IDs (for example gclid) where applicable;</p>\\n<p>cookie consent choices and Consent Mode signals.</p>\\n\\n<h2>3.3. Data from other sources</h2>\\n<p>information made available through Google Analytics, Google Ads and other advertising/analytics platforms according to their settings;</p>\\n<p>information supplied by a client or its authorised personnel for the performance of our services;</p>\\n<p>business contact information from public business sources or referrals where permitted by law.</p>\\n\\n<h2>3.4. Special-category data</h2>\\n<p>We do not ask you to submit health data, biometric data, political or religious beliefs, sexual-life data, criminal-conviction data or other sensitive information through the website. Please do not include such information in free-text fields or Calendly unless it is strictly necessary.</p>\\n\\n<h2>4. Purposes and legal bases</h2>\\n<p>The specific legal basis depends on the context. For individuals in the EEA/UK we refer to the relevant GDPR/UK GDPR basis; Ukrainian data-protection law also applies to our activities in Ukraine.</p>\\n\\n<table>\\n<thead><tr><th>Purpose</th><th>Data categories</th><th>Legal basis</th></tr></thead>\\n<tbody>\\n<tr><td>Responding to an enquiry, free audit, or proposal request</td><td>Form data, correspondence, contact and project information</td><td>Steps taken at the individual\u2019s request before entering into a contract (GDPR Art. 6(1)(b)); where appropriate, legitimate interests (Art. 6(1)(f))</td></tr>\\n<tr><td>Providing PPC/analytics services and managing the client relationship</td><td>Contact, contractual and project data, system-access information</td><td>Performance of a contract (Art. 6(1)(b)); legitimate interests for B2B administration (Art. 6(1)(f))</td></tr>\\n<tr><td>Accounting, tax and legal compliance</td><td>Contractual and financial records</td><td>Legal obligation (Art. 6(1)(c))</td></tr>\\n<tr><td>Website security, abuse prevention and technical logging</td><td>IP address, request logs, technical data</td><td>Legitimate interests in protecting our website and services (Art. 6(1)(f))</td></tr>\\n<tr><td>Managing and proving cookie consent/withdrawal</td><td>Consent state, consent ID and relevant technical data</td><td>Legal obligation and/or legitimate interests in demonstrating compliance (Art. 6(1)(c)/(f))</td></tr>\\n<tr><td>Statistics and analytics using non-essential cookies</td><td>Cookie identifiers, events and interactions</td><td>Consent (Art. 6(1)(a))</td></tr>\\n<tr><td>Limited measurement under Advanced Consent Mode while consent is denied</td><td>Consent signals and cookie-free measurements supported by Google</td><td>Legitimate interests in privacy-preserving measurement where permitted by law (Art. 6(1)(f)); where local law requires consent, processing occurs only after consent</td></tr>\\n<tr><td>Advertising personalisation / marketing cookies, if enabled</td><td>Advertising identifiers and interaction data</td><td>Consent (Art. 6(1)(a))</td></tr>\\n<tr><td>Scheduling a meeting through Calendly</td><td>Name, email, meeting time, booking-form answers</td><td>Pre-contract steps and/or legitimate interests in arranging the meeting (Art. 6(1)(b)/(f)); optional cookies are consent-based where required</td></tr>\\n</tbody></table>\\n\\n<h2>5. Cookies, Cookiebot and Google Consent Mode v2</h2>\\n<p>We use Cookiebot CMP by Usercentrics to manage cookie consent. The banner allows visitors to allow all cookies, choose categories, or reject non-essential cookies. Categories may include Necessary, Preferences, Statistics and Marketing.</p>\\n<p>Non-essential cookies and storage should not be activated until the relevant consent is given. You can change or withdraw your choice at any time through Cookie Settings / the Cookie Declaration on the website.</p>\\n<p>The website uses Google Consent Mode v2 in Advanced mode. Before the user makes a choice, the relevant consent states are configured as denied. In Advanced mode, Google tags may load and send limited cookie-free measurements (\u201Ccookieless pings\u201D) together with the consent state. While analytics_storage or ad_storage remains denied, analytics/advertising cookies should not be read or written. After consent is granted, Google may receive fuller measurement data according to the categories you allowed.</p>\\n<p>Consent Mode includes, among other signals, analytics_storage, ad_storage, ad_user_data and ad_personalization.</p>\\n<p>The current list of cookies/trackers, providers, purposes and retention periods is shown in the dynamic Cookie Declaration generated by Cookiebot. This is the primary source for cookie-specific details because it updates as the website is rescanned.</p>\\n\\n<div id=\\"CookieDeclarationContainer\\"></div>\\n<h2>6. Service providers and recipients</h2>\\n<p>We disclose personal data only to the extent needed for the relevant purpose and use contractual/technical safeguards where applicable. Key categories of recipients are listed below.</p>\\n\\n<table>\\n<thead><tr><th>Provider / category</th><th>Use</th><th>Data that may be processed</th></tr></thead>\\n<tbody>\\n<tr><td>Cloudflare</td><td>Hosting/CDN/DNS, security and traffic proxying; email routing where enabled</td><td>IP addresses, request logs, technical metadata, email-routing metadata</td></tr>\\n<tr><td>Google</td><td>Google Tag Manager, Google Analytics 4, Google Ads measurement; email services where used for correspondence</td><td>Technical data, analytics events, cookie/click IDs, consent signals, correspondence data</td></tr>\\n<tr><td>Usercentrics / Cookiebot</td><td>CMP, consent banner and recording/documenting visitor choices</td><td>Consent state, consent ID and technical data needed to operate the CMP</td></tr>\\n<tr><td>Calendly, LLC</td><td>Popup/widget and meeting scheduling</td><td>Name, email, date/time, time zone, booking-form answers and technical data</td></tr>\\n<tr><td>Email providers, professional advisers and contractors</td><td>Business correspondence, accounting, legal or technical support</td><td>Only the data necessary for the relevant service</td></tr>\\n</tbody></table>\\n\\n<h2>7. International transfers</h2>\\n<p>Photon Digital is established in Ukraine, while some infrastructure and service providers operate in the EEA, the United States and other countries. Personal data may therefore be processed outside the country where you are located.</p>\\n<p>Where GDPR/UK GDPR applies, transfers are supported by lawful mechanisms as applicable, including adequacy decisions, the EU-U.S. Data Privacy Framework and relevant extensions, Standard Contractual Clauses (SCCs), or other appropriate safeguards depending on the provider and transfer route.</p>\\n<p>Calendly states that user and invitee data are stored in U.S.-based data centres and that Calendly is certified under the EU-U.S. Data Privacy Framework. Cloudflare and Google also publish information about DPF/SCC mechanisms and other international-transfer safeguards.</p>\\n<p>You may contact info@photon-digital.com to request further information about the transfer mechanism relevant to your data.</p>\\n\\n<h2>8. Retention</h2>\\n<p>Prospect enquiries that do not become a client relationship: generally up to 24 months after the last meaningful interaction, unless we have a reason to keep them longer or delete them sooner.</p>\\n<p>Current/former client data, contracts, invoices and accounting records: for the duration of the relationship and afterwards for the period required by applicable tax, accounting or other law or to establish, exercise or defend legal claims.</p>\\n<p>Calendly booking data: for as long as needed to arrange the meeting and manage the related business relationship; Calendly may also retain data according to its own settings and privacy notice.</p>\\n<p>Google Analytics 4: user-level/event-level retention is governed by the GA4 property setting (Google provides 2- or 14-month options for standard properties). Aggregated reporting may remain available for longer. Cookie-specific expiry periods are shown in the Cookie Declaration.</p>\\n<p>Consent records: for as long as reasonably necessary to demonstrate compliance with consent requirements and according to CMP settings.</p>\\n\\n<h2>9. Security</h2>\\n<p>We use reasonable technical and organisational measures proportionate to risk, including HTTPS/TLS, access controls, least-privilege access, multi-factor authentication where available, restrictions on access to client accounts, and reputable service providers with appropriate security measures.</p>\\n<p>No method of transmission or storage can guarantee absolute security.</p>\\n\\n<h2>10. Your rights</h2>\\n<p>Depending on applicable law, you may have the right to obtain information and a copy of your data; correct inaccurate data; request deletion; restrict processing; object to processing based on legitimate interests; receive portable data where applicable; withdraw consent without affecting processing already lawfully carried out; and lodge a complaint with a competent supervisory authority.</p>\\n<p>To exercise your rights, email info@photon-digital.com. We may request the minimum additional information needed to verify your identity. Requests are handled within the time limits required by applicable law (under GDPR, normally within one month).</p>\\n<p>In Ukraine, you may complain to the Ukrainian Parliament Commissioner for Human Rights or a court. Where GDPR applies, you may also complain to the supervisory authority in the EEA country of your habitual residence, place of work, or the alleged infringement.</p>\\n\\n<h2>11. Automated decision-making</h2>\\n<p>Photon Digital does not make decisions about website visitors or people who contact us that are based solely on automated processing and produce legal or similarly significant effects within the meaning of GDPR Article 22.</p>\\n\\n<h2>12. Children\u2019s data</h2>\\n<p>Photon Digital is a business-to-business service and the website is not directed to children. We do not knowingly collect children\u2019s personal data through the website. If you believe a child has provided us with personal data, please contact info@photon-digital.com.</p>\\n\\n<h2>13. Sale of personal data and marketing emails</h2>\\n<p>We do not sell personal data. As of the date of this Policy, the website form is not used to subscribe visitors to a bulk marketing-email newsletter. If such communications are introduced, we will use an appropriate legal basis and provide an unsubscribe mechanism.</p>\\n\\n<h2>14. Changes to this Policy</h2>\\n<p>We may update this Policy when our services, technology, vendors or legal requirements change. The current version will be published on this page with an updated \u201CLast updated\u201D date.</p>\\n\\n<h2>15. Contact</h2>\\n<p>Photon Digital / sole proprietor Borys Kuzmeniuk (\u041A\u0443\u0437\u044C\u043C\u0435\u043D\u044E\u043A \u0411\u043E\u0440\u0438\u0441 \u041E\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u0438\u0447)</p>\\n<p>Privacy email: info@photon-digital.com</p>\\n<p>Website: https://photon-digital.com/</p>\\n<p>Registered address: 21 Striletska Street, Vinnytsia, Vinnytsia District, Vinnytsia Region, 21007, Ukraine.</p>\\n\\n</article>","cookieDeclaration":{"provider":"Cookiebot by Usercentrics","cbid":"c9cf4fbc-5b88-4c9e-b085-806c4aba649a","declarationScriptSrc":"https://consent.cookiebot.com/c9cf4fbc-5b88-4c9e-b085-806c4aba649a/cd.js","culture":"en","scriptId":"CookieDeclaration","async":true}}}');


