7\u0432\u0435\u0440\u043D\u0435\u043D\u044C, \u0443\u043A\u043B\u0430\u0434\u0435\u043D\u043D\u044F \u0442\u0430 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0456\u0432, \u0432\u0435\u0434\u0435\u043D\u043D\u044F \u043A\u043B\u0456\u0454\u043D\u0442\u0441\u044C\u043A\u0438\u0445 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D \u0456 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u044E\u0440\u0438\u0434\u0438\u0447\u043D\u0438\u0445 \u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043A\u0456\u0432, Photon Digital \u0454 \u0432\u043E\u043B\u043E\u0434\u0456\u043B\u044C\u0446\u0435\u043C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0430\u043D\u0438\u0445 / \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u043E\u043C \u0443 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u0456 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u043D\u043E\u0433\u043E \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0432\u0441\u0442\u0432\u0430.</p>\\n<p>\u041A\u043E\u043B\u0438 \u043C\u0438 \u043F\u0440\u0430\u0446\u044E\u0454\u043C\u043E \u0432 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0438\u0445, \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0438\u0445, CRM \u0430\u0431\u043E \u0456\u043D\u0448\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u043A\u043B\u0456\u0454\u043D\u0442\u0430 \u0432\u0438\u043A\u043B\u044E\u0447\u043D\u043E \u0437\u0430 \u0439\u043E\u0433\u043E \u0456\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F\u043C\u0438, Photon Digital \u043C\u043E\u0436\u0435 \u0434\u0456\u044F\u0442\u0438 \u044F\u043A \u0440\u043E\u0437\u043F\u043E\u0440\u044F\u0434\u043D\u0438\u043A / \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440, \u0430 \u043A\u043B\u0456\u0454\u043D\u0442 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u043E\u043C. \u0422\u0430\u043A\u0456 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D\u0438 \u043C\u0430\u044E\u0442\u044C \u0440\u0435\u0433\u0443\u043B\u044E\u0432\u0430\u0442\u0438\u0441\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u043C \u0442\u0430, \u043A\u043E\u043B\u0438 \u0446\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E, \u0443\u0433\u043E\u0434\u043E\u044E \u043F\u0440\u043E \u043E\u0431\u0440\u043E\u0431\u043A\u0443 \u0434\u0430\u043D\u0438\u0445 (DPA).</p>\\n\\n<h2>2. \u0421\u0444\u0435\u0440\u0430 \u0434\u0456\u0457 \u0446\u0456\u0454\u0457 \u041F\u043E\u043B\u0456\u0442\u0438\u043A\u0438</h2>\\n<p>\u041F\u043E\u043B\u0456\u0442\u0438\u043A\u0430 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F \u0434\u043E \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456\u0432 \u0441\u0430\u0439\u0442\u0443, \u043E\u0441\u0456\u0431, \u044F\u043A\u0456 \u043D\u0430\u0434\u0441\u0438\u043B\u0430\u044E\u0442\u044C \u0437\u0430\u044F\u0432\u043A\u0443 \u0430\u0431\u043E \u043B\u0438\u0441\u0442, \u0431\u0440\u043E\u043D\u044E\u044E\u0442\u044C \u0437\u0443\u0441\u0442\u0440\u0456\u0447, \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0439\u043D\u0438\u0445 \u0456 \u0447\u0438\u043D\u043D\u0438\u0445 \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0456\u043D\u0448\u0438\u0445 \u0434\u0456\u043B\u043E\u0432\u0438\u0445 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432.</p>\\n<p>\u0412\u043E\u043D\u0430 \u043E\u043F\u0438\u0441\u0443\u0454 \u043D\u0430\u0448\u0443 \u0432\u043B\u0430\u0441\u043D\u0443 \u043E\u0431\u0440\u043E\u0431\u043A\u0443 \u0434\u0430\u043D\u0438\u0445. \u042F\u043A\u0449\u043E \u043C\u0438 \u043E\u0431\u0440\u043E\u0431\u043B\u044F\u0454\u043C\u043E \u0434\u0430\u043D\u0456 \u0432\u0456\u0434 \u0456\u043C\u0435\u043D\u0456 \u043A\u043B\u0456\u0454\u043D\u0442\u0430, \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0449\u043E\u0434\u043E \u0442\u0430\u043A\u0438\u0445 \u0434\u0430\u043D\u0438\u0445 \u043D\u0430\u0441\u0430\u043C\u043F\u0435\u0440\u0435\u0434 \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u044E\u0442\u044C\u0441\u044F \u0456\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u044F\u043C\u0438 \u043A\u043B\u0456\u0454\u043D\u0442\u0430 \u0442\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u043C \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u043C.</p>\\n\\n<h2>3. \u042F\u043A\u0456 \u0434\u0430\u043D\u0456 \u043C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438</h2>\\n\\n<h2>3.1. \u0414\u0430\u043D\u0456, \u044F\u043A\u0456 \u0432\u0438 \u043D\u0430\u0434\u0430\u0454\u0442\u0435 \u0441\u0430\u043C\u0456</h2>\\n<p>\u0447\u0435\u0440\u0435\u0437 \u0444\u043E\u0440\u043C\u0443 \u043D\u0430 \u0441\u0430\u0439\u0442\u0456: \u0456\u043C\u2019\u044F, email \u0442\u0430 \u0442\u0435\u043A\u0441\u0442 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456, \u044F\u043A\u0456 \u0432\u0438 \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u0432\u043A\u0430\u0436\u0435\u0442\u0435;</p>\\n<p>\u043F\u0456\u0434 \u0447\u0430\u0441 \u0431\u0440\u043E\u043D\u044E\u0432\u0430\u043D\u043D\u044F \u0447\u0435\u0440\u0435\u0437 Calendly: \u0456\u043C\u2019\u044F, email, \u043E\u0431\u0440\u0430\u043D\u0456 \u0434\u0430\u0442\u0430 \u0439 \u0447\u0430\u0441, \u0447\u0430\u0441\u043E\u0432\u0438\u0439 \u043F\u043E\u044F\u0441, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456 \u043D\u0430 \u043F\u0438\u0442\u0430\u043D\u043D\u044F \u0444\u043E\u0440\u043C\u0438 \u0431\u0440\u043E\u043D\u044E\u0432\u0430\u043D\u043D\u044F \u0442\u0430 \u0456\u043D\u0448\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456, \u044F\u043A\u0456 \u0432\u0438 \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u043D\u0430\u0434\u0430\u0441\u0442\u0435;</p>\\n<p>\u0443 \u043B\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u0456: \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u0456 \u0434\u0430\u043D\u0456, \u0437\u043C\u0456\u0441\u0442 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u044C \u0442\u0430 \u0432\u043A\u043B\u0430\u0434\u0435\u043D\u043D\u044F;</p>\\n<p>\u043F\u0456\u0434 \u0447\u0430\u0441 \u043A\u043B\u0456\u0454\u043D\u0442\u0441\u044C\u043A\u0438\u0445 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D: \u0456\u043C\u2019\u044F, \u043F\u043E\u0441\u0430\u0434\u0430, \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u044F, \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u0456 \u0442\u0430 \u0434\u043E\u0433\u043E\u0432\u0456\u0440\u043D\u0456 \u0434\u0430\u043D\u0456, \u043F\u043B\u0430\u0442\u0456\u0436\u043D\u0456/\u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u044C\u043A\u0456 \u0440\u0435\u043A\u0432\u0456\u0437\u0438\u0442\u0438, \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E \u043F\u0440\u043E\u0454\u043A\u0442, \u0430 \u0442\u0430\u043A\u043E\u0436 \u0434\u0430\u043D\u0456 \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0434\u043E \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0438\u0445 \u0442\u0430 \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C \u0443 \u043C\u0435\u0436\u0430\u0445, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0445 \u0434\u043B\u044F \u043D\u0430\u0434\u0430\u043D\u043D\u044F \u043F\u043E\u0441\u043B\u0443\u0433.</p>\\n\\n<h2>3.2. \u0422\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0442\u0430 \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0456 \u0434\u0430\u043D\u0456</h2>\\n<p>IP-\u0430\u0434\u0440\u0435\u0441\u0430, \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u0435 \u043C\u0456\u0441\u0446\u0435\u0437\u043D\u0430\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F, \u0442\u0438\u043F \u0456 \u0432\u0435\u0440\u0441\u0456\u044F \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430, \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439, \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430, \u043C\u043E\u0432\u0430, URL \u0442\u0430 referrer, \u0434\u0430\u0442\u0430 \u0456 \u0447\u0430\u0441 \u0437\u0430\u043F\u0438\u0442\u0443, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0436\u0443\u0440\u043D\u0430\u043B\u0438 \u0431\u0435\u0437\u043F\u0435\u043A\u0438;</p>\\n<p>\u0434\u0430\u043D\u0456 \u043F\u0440\u043E \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0438 \u0441\u0442\u043E\u0440\u0456\u043D\u043E\u043A \u0456 \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457 \u0456\u0437 \u0441\u0430\u0439\u0442\u043E\u043C, \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u0438 cookie/local storage \u0442\u0430 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0456 \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u0438 \u0430\u0431\u043E click ID (\u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, gclid), \u044F\u043A\u0449\u043E \u0432\u043E\u043D\u0438 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F;</p>\\n<p>\u0441\u0442\u0430\u043D \u0437\u0433\u043E\u0434\u0438 \u043D\u0430 cookies \u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u0441\u0438\u0433\u043D\u0430\u043B\u0438 Consent Mode.</p>\\n\\n<h2>3.3. \u0414\u0430\u043D\u0456 \u0437 \u0456\u043D\u0448\u0438\u0445 \u0434\u0436\u0435\u0440\u0435\u043B</h2>\\n<p>\u0434\u0430\u043D\u0456, \u044F\u043A\u0456 \u043D\u0430\u0434\u0445\u043E\u0434\u044F\u0442\u044C \u0456\u0437 Google Analytics, Google Ads \u0442\u0430 \u0456\u043D\u0448\u0438\u0445 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0438\u0445/\u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0438\u0445 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C \u0443 \u043C\u0435\u0436\u0430\u0445 \u0457\u0445\u043D\u0456\u0445 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u044C;</p>\\n<p>\u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F, \u043D\u0430\u0434\u0430\u043D\u0430 \u043A\u043B\u0456\u0454\u043D\u0442\u043E\u043C \u0430\u0431\u043E \u0439\u043E\u0433\u043E \u0443\u043F\u043E\u0432\u043D\u043E\u0432\u0430\u0436\u0435\u043D\u0438\u043C\u0438 \u043E\u0441\u043E\u0431\u0430\u043C\u0438 \u0434\u043B\u044F \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443;</p>\\n<p>\u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u0456 \u0434\u0430\u043D\u0456 \u0437 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0445 \u0431\u0456\u0437\u043D\u0435\u0441-\u0434\u0436\u0435\u0440\u0435\u043B \u0430\u0431\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0456\u0439, \u044F\u043A\u0449\u043E \u0446\u0435 \u0434\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u043E \u0437\u0430\u043A\u043E\u043D\u043E\u043C.</p>\\n\\n<h2>3.4. \u0421\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0456 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \u0434\u0430\u043D\u0438\u0445</h2>\\n<p>\u041C\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u043C\u043E \u043D\u0430\u0434\u0441\u0438\u043B\u0430\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u0430\u0439\u0442 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456 \u043F\u0440\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u2019\u044F, \u0431\u0456\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u0456 \u0434\u0430\u043D\u0456, \u043F\u043E\u043B\u0456\u0442\u0438\u0447\u043D\u0456 \u0447\u0438 \u0440\u0435\u043B\u0456\u0433\u0456\u0439\u043D\u0456 \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u043D\u043D\u044F, \u0441\u0435\u043A\u0441\u0443\u0430\u043B\u044C\u043D\u0435 \u0436\u0438\u0442\u0442\u044F, \u0441\u0443\u0434\u0438\u043C\u043E\u0441\u0442\u0456 \u0430\u0431\u043E \u0456\u043D\u0448\u0456 \u0447\u0443\u0442\u043B\u0438\u0432\u0456 \u0434\u0430\u043D\u0456. \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435 \u0442\u0430\u043A\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456 \u0443 \u0432\u0456\u043B\u044C\u043D\u0438\u0439 \u0442\u0435\u043A\u0441\u0442 \u0444\u043E\u0440\u043C\u0438 \u0430\u0431\u043E \u0432 Calendly, \u044F\u043A\u0449\u043E \u0446\u0435 \u043D\u0435 \u0454 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u043C.</p>\\n\\n<h2>4. \u0414\u043B\u044F \u0447\u043E\u0433\u043E \u043C\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u043C\u043E \u0434\u0430\u043D\u0456 \u0442\u0430 \u043F\u0440\u0430\u0432\u043E\u0432\u0456 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0438</h2>\\n<p>\u041A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0432\u0430 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0430 \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u0432\u0456\u0434 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0443. \u0414\u043B\u044F \u043E\u0441\u0456\u0431 \u0443 \u0404\u0415\u0417/\u0412\u0435\u043B\u0438\u043A\u0456\u0439 \u0411\u0440\u0438\u0442\u0430\u043D\u0456\u0457 \u043C\u0438 \u043E\u0440\u0456\u0454\u043D\u0442\u0443\u0454\u043C\u043E\u0441\u044F \u043D\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u043D\u043E\u0440\u043C\u0438 GDPR/UK GDPR; \u0432 \u0423\u043A\u0440\u0430\u0457\u043D\u0456 \u2014 \u0442\u0430\u043A\u043E\u0436 \u043D\u0430 \u0417\u0430\u043A\u043E\u043D \u0423\u043A\u0440\u0430\u0457\u043D\u0438 \xab\u041F\u0440\u043E \u0437\u0430\u0445\u0438\u0441\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0430\u043D\u0438\u0445\xbb.</p>\\n\\n<table>\\n<thead><tr><th>\u041C\u0435\u0442\u0430</th><th>\u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \u0434\u0430\u043D\u0438\u0445</th><th>\u041F\u0440\u0430\u0432\u043E\u0432\u0430 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0430</th></tr></thead>\\n<tbody>\\n<tr><td>\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C \u043D\u0430 \u0437\u0430\u044F\u0432\u043A\u0443, \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0438\u0439 \u0430\u0443\u0434\u0438\u0442, \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457</td><td>\u0414\u0430\u043D\u0456 \u0444\u043E\u0440\u043C\u0438, \u043B\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F, \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u0456 \u0442\u0430 \u043F\u0440\u043E\u0454\u043A\u0442\u043D\u0456 \u0434\u0430\u043D\u0456</td><td>\u041A\u0440\u043E\u043A\u0438 \u043D\u0430 \u0437\u0430\u043F\u0438\u0442 \u043E\u0441\u043E\u0431\u0438 \u0434\u043E \u0443\u043A\u043B\u0430\u0434\u0435\u043D\u043D\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443 (GDPR Art. 6(1)(b)); \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0445 \u0432\u0438\u043F\u0430\u0434\u043A\u0430\u0445 \u2014 \u0437\u0430\u043A\u043E\u043D\u043D\u0438\u0439 \u0456\u043D\u0442\u0435\u0440\u0435\u0441 (Art. 6(1)(f))</td></tr>\\n<tr><td>\u041D\u0430\u0434\u0430\u043D\u043D\u044F PPC/\u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0438\u0445 \u043F\u043E\u0441\u043B\u0443\u0433 \u0456 \u0432\u0435\u0434\u0435\u043D\u043D\u044F \u043A\u043B\u0456\u0454\u043D\u0442\u0441\u044C\u043A\u0438\u0445 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D</td><td>\u041A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u0456, \u0434\u043E\u0433\u043E\u0432\u0456\u0440\u043D\u0456, \u043F\u0440\u043E\u0454\u043A\u0442\u043D\u0456 \u0434\u0430\u043D\u0456, \u0434\u0430\u043D\u0456 \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0434\u043E \u0441\u0438\u0441\u0442\u0435\u043C</td><td>\u0412\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443 (Art. 6(1)(b)); \u0437\u0430\u043A\u043E\u043D\u043D\u0438\u0439 \u0456\u043D\u0442\u0435\u0440\u0435\u0441 \u0434\u043B\u044F B2B-\u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0443\u0432\u0430\u043D\u043D\u044F (Art. 6(1)(f))</td></tr>\\n<tr><td>\u0411\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0456\u044F, \u043F\u043E\u0434\u0430\u0442\u043A\u0438, \u044E\u0440\u0438\u0434\u0438\u0447\u043D\u0456 \u0432\u0438\u043C\u043E\u0433\u0438</td><td>\u0414\u043E\u0433\u043E\u0432\u0456\u0440\u043D\u0456 \u0442\u0430 \u0444\u0456\u043D\u0430\u043D\u0441\u043E\u0432\u0456 \u0434\u0430\u043D\u0456</td><td>\u042E\u0440\u0438\u0434\u0438\u0447\u043D\u0438\u0439 \u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043E\u043A (Art. 6(1)(c))</td></tr>\\n<tr><td>\u0411\u0435\u0437\u043F\u0435\u043A\u0430 \u0441\u0430\u0439\u0442\u0443, \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0430 \u0437\u0456 \u0437\u043B\u043E\u0432\u0436\u0438\u0432\u0430\u043D\u043D\u044F\u043C\u0438, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0436\u0443\u0440\u043D\u0430\u043B\u0438</td><td>IP, \u0436\u0443\u0440\u043D\u0430\u043B\u0438 \u0437\u0430\u043F\u0438\u0442\u0456\u0432, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0434\u0430\u043D\u0456</td><td>\u0417\u0430\u043A\u043E\u043D\u043D\u0438\u0439 \u0456\u043D\u0442\u0435\u0440\u0435\u0441 \u0443 \u0437\u0430\u0445\u0438\u0441\u0442\u0456 \u0441\u0430\u0439\u0442\u0443 \u0442\u0430 \u0441\u0435\u0440\u0432\u0456\u0441\u0456\u0432 (Art. 6(1)(f))</td></tr>\\n<tr><td>\u041A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0433\u043E\u0434\u043E\u044E \u0442\u0430 \u0434\u043E\u043A\u0430\u0437 \u0437\u0433\u043E\u0434\u0438/\u0432\u0456\u0434\u043C\u043E\u0432\u0438</td><td>\u0421\u0442\u0430\u043D \u0437\u0433\u043E\u0434\u0438, consent ID, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0434\u0430\u043D\u0456</td><td>\u042E\u0440\u0438\u0434\u0438\u0447\u043D\u0438\u0439 \u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043E\u043A \u0442\u0430/\u0430\u0431\u043E \u0437\u0430\u043A\u043E\u043D\u043D\u0438\u0439 \u0456\u043D\u0442\u0435\u0440\u0435\u0441 \u0443 \u0434\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u0456 \u0434\u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u043F\u0440\u0430\u0432\u0438\u043B \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u043E\u0441\u0442\u0456 (Art. 6(1)(c)/(f))</td></tr>\\n<tr><td>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u0442\u0430 \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u043A\u0430 \u0437 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F\u043C non-essential cookies</td><td>Cookie/\u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u0438, \u043F\u043E\u0434\u0456\u0457, \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457</td><td>\u0417\u0433\u043E\u0434\u0430 (Art. 6(1)(a))</td></tr>\\n<tr><td>\u041E\u0431\u043C\u0435\u0436\u0435\u043D\u0435 \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F \u0432 Advanced Consent Mode \u043F\u0440\u0438 denied</td><td>\u0421\u0438\u0433\u043D\u0430\u043B\u0438 \u0437\u0433\u043E\u0434\u0438 \u0442\u0430 \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F \u0431\u0435\u0437 cookies, \u044F\u043A\u0456 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C\u0441\u044F Google</td><td>\u0417\u0430\u043A\u043E\u043D\u043D\u0438\u0439 \u0456\u043D\u0442\u0435\u0440\u0435\u0441 \u0443 privacy-preserving \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u0456, \u0434\u0435 \u0446\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0454\u0442\u044C\u0441\u044F \u0437\u0430\u043A\u043E\u043D\u043E\u043C (Art. 6(1)(f)); \u044F\u043A\u0449\u043E \u043C\u0456\u0441\u0446\u0435\u0432\u0435 \u043F\u0440\u0430\u0432\u043E \u0432\u0438\u043C\u0430\u0433\u0430\u0454 \u0437\u0433\u043E\u0434\u0438 \u2014 \u043E\u0431\u0440\u043E\u0431\u043A\u0430 \u0437\u0434\u0456\u0439\u0441\u043D\u044E\u0454\u0442\u044C\u0441\u044F \u043B\u0438\u0448\u0435 \u043F\u0456\u0441\u043B\u044F \u0437\u0433\u043E\u0434\u0438</td></tr>\\n<tr><td>\u0420\u0435\u043A\u043B\u0430\u043C\u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F / \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u0432\u0456 cookies, \u044F\u043A\u0449\u043E \u0443\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E</td><td>\u0420\u0435\u043A\u043B\u0430\u043C\u043D\u0456 \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u0438 \u0442\u0430 \u0434\u0430\u043D\u0456 \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457</td><td>\u0417\u0433\u043E\u0434\u0430 (Art. 6(1)(a))</td></tr>\\n<tr><td>\u0411\u0440\u043E\u043D\u044E\u0432\u0430\u043D\u043D\u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456 \u0447\u0435\u0440\u0435\u0437 Calendly</td><td>\u0406\u043C\u2019\u044F, email, \u0447\u0430\u0441 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456 \u0444\u043E\u0440\u043C\u0438</td><td>\u041A\u0440\u043E\u043A\u0438 \u0434\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443 \u0442\u0430/\u0430\u0431\u043E \u0437\u0430\u043A\u043E\u043D\u043D\u0438\u0439 \u0456\u043D\u0442\u0435\u0440\u0435\u0441 \u0443 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0457 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456 (Art. 6(1)(b)/(f)); \u043E\u043A\u0440\u0435\u043C\u0456 optional cookies \u2014 \u0437\u0430 \u0437\u0433\u043E\u0434\u043E\u044E</td></tr>\\n</tbody></table>\\n\\n<h2>5. Cookies, Cookiebot \u0442\u0430 Google Consent Mode v2</h2>\\n<p>\u0414\u043B\u044F \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0433\u043E\u0434\u043E\u044E \u043C\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u043C\u043E Cookiebot CMP by Usercentrics. \u0411\u0430\u043D\u0435\u0440 \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438 \u0432\u0441\u0456 cookies, \u043E\u0431\u0440\u0430\u0442\u0438 \u043E\u043A\u0440\u0435\u043C\u0456 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \u0430\u0431\u043E \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0442\u0438\u0441\u044F \u0432\u0456\u0434 \u043D\u0435\u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043A\u043E\u0432\u0438\u0445 cookies. \u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \u043C\u043E\u0436\u0443\u0442\u044C \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u0438 Necessary, Preferences, Statistics \u0442\u0430 Marketing.</p>\\n<p>\u041D\u0435\u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043A\u043E\u0432\u0456 cookies \u0442\u0430 \u0441\u0445\u043E\u0432\u0438\u0449\u0430 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0430\u043A\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0434\u043E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E\u0457 \u0437\u0433\u043E\u0434\u0438. \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0430\u0431\u043E \u0432\u0456\u0434\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0437\u0433\u043E\u0434\u0443 \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0447\u0435\u0440\u0435\u0437 Cookie Settings / Cookie Declaration \u043D\u0430 \u0441\u0430\u0439\u0442\u0456.</p>\\n<p>\u041D\u0430 \u0441\u0430\u0439\u0442\u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F Google Consent Mode v2 \u0432 Advanced mode. \u0414\u043E \u0432\u0438\u0431\u043E\u0440\u0443 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u0441\u0442\u0430\u043D\u0438 consent \u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0456 \u044F\u043A denied. \u0423 \u0446\u044C\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456 \u0442\u0435\u0433\u0438 Google \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0442\u0430 \u043D\u0430\u0434\u0441\u0438\u043B\u0430\u0442\u0438 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0456 \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F \u0431\u0435\u0437 cookies (cookieless pings) \u0440\u0430\u0437\u043E\u043C \u0437\u0456 \u0441\u0442\u0430\u043D\u043E\u043C \u0437\u0433\u043E\u0434\u0438. \u041A\u043E\u043B\u0438 analytics_storage \u0430\u0431\u043E ad_storage \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F denied, \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0456/\u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0456 cookies \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0456 \u0447\u0438\u0442\u0430\u0442\u0438\u0441\u044F \u0430\u0431\u043E \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438\u0441\u044F. \u041F\u0456\u0441\u043B\u044F \u043D\u0430\u0434\u0430\u043D\u043D\u044F \u0437\u0433\u043E\u0434\u0438 Google \u043C\u043E\u0436\u0435 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u043F\u043E\u0432\u043D\u0456\u0448\u0456 \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043B\u044C\u043D\u0456 \u0434\u0430\u043D\u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u0432\u0438\u0431\u0440\u0430\u043D\u0438\u0445 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0439.</p>\\n<p>Consent Mode \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454, \u0437\u043E\u043A\u0440\u0435\u043C\u0430, \u0441\u0438\u0433\u043D\u0430\u043B\u0438 analytics_storage, ad_storage, ad_user_data \u0442\u0430 ad_personalization.</p>\\n<p>\u0410\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u043B\u0456\u043A cookies/\u0442\u0440\u0435\u043A\u0435\u0440\u0456\u0432, \u0457\u0445 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0456\u0432, \u0446\u0456\u043B\u0435\u0439 \u0456 \u0441\u0442\u0440\u043E\u043A\u0456\u0432 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043D\u043D\u044F \u043F\u043E\u043A\u0430\u0437\u0443\u0454\u0442\u044C\u0441\u044F \u0432 \u0434\u0438\u043D\u0430\u043C\u0456\u0447\u043D\u0456\u0439 Cookie Declaration, \u0441\u0444\u043E\u0440\u043C\u043E\u0432\u0430\u043D\u0456\u0439 Cookiebot. \u0412\u043E\u043D\u0430 \u0454 \u043F\u0440\u0456\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u0438\u043C \u0434\u0436\u0435\u0440\u0435\u043B\u043E\u043C \u0434\u043B\u044F \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0438\u0445 cookie, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u043E\u043D\u043E\u0432\u043B\u044E\u0454\u0442\u044C\u0441\u044F \u043F\u0456\u0441\u043B\u044F \u0441\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0441\u0430\u0439\u0442\u0443.</p>\\n\\n<div id=\\"CookieDeclarationContainer\\"></div>\\n<h2>6. \u041F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0438 \u043F\u043E\u0441\u043B\u0443\u0433 \u0442\u0430 \u043E\u0434\u0435\u0440\u0436\u0443\u0432\u0430\u0447\u0456 \u0434\u0430\u043D\u0438\u0445</h2>\\n<p>\u041C\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0454\u043C\u043E \u0434\u0430\u043D\u0456 \u043B\u0438\u0448\u0435 \u0432 \u043E\u0431\u0441\u044F\u0437\u0456, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E\u043C\u0443 \u0434\u043B\u044F \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0457 \u043C\u0435\u0442\u0438, \u0442\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u043C\u043E \u0434\u043E\u0433\u043E\u0432\u0456\u0440\u043D\u0456/\u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0437\u0430\u0445\u043E\u0434\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0443, \u0434\u0435 \u0446\u0435 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u043D\u043E. \u041A\u043B\u044E\u0447\u043E\u0432\u0456 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0456\u0432 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0456 \u043D\u0438\u0436\u0447\u0435.</p>\\n\\n<table>\\n<thead><tr><th>\u041F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A / \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u044F</th><th>\u0414\u043B\u044F \u0447\u043E\u0433\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F</th><th>\u042F\u043A\u0456 \u0434\u0430\u043D\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u043E\u0431\u0440\u043E\u0431\u043B\u044F\u0442\u0438\u0441\u044F</th></tr></thead>\\n<tbody>\\n<tr><td>Cloudflare</td><td>\u0425\u043E\u0441\u0442\u0438\u043D\u0433/CDN/DNS, \u0431\u0435\u0437\u043F\u0435\u043A\u0430, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0435 \u043F\u0440\u043E\u043A\u0441\u0443\u0432\u0430\u043D\u043D\u044F \u0442\u0440\u0430\u0444\u0456\u043A\u0443; \u0437\u0430 \u043D\u0430\u044F\u0432\u043D\u043E\u0441\u0442\u0456 \u2014 email routing</td><td>IP, \u0436\u0443\u0440\u043D\u0430\u043B\u0438 \u0437\u0430\u043F\u0438\u0442\u0456\u0432, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u043C\u0435\u0442\u0430\u0434\u0430\u043D\u0456, \u043C\u0435\u0442\u0430\u0434\u0430\u043D\u0456 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0456\u0457 email</td></tr>\\n<tr><td>Google</td><td>Google Tag Manager, Google Analytics 4, \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F Google Ads; email-\u0441\u0435\u0440\u0432\u0456\u0441\u0438, \u044F\u043A\u0449\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F \u0434\u043B\u044F \u043B\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F</td><td>\u0422\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0434\u0430\u043D\u0456, \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0447\u043D\u0456 \u043F\u043E\u0434\u0456\u0457, cookie/click ID, consent signals, \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u0456 \u0434\u0430\u043D\u0456 \u0443 \u043B\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u0456</td></tr>\\n<tr><td>Usercentrics / Cookiebot</td><td>CMP, \u043F\u043E\u043A\u0430\u0437 \u0431\u0430\u043D\u0435\u0440\u0430, \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0442\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0432\u0438\u0431\u043E\u0440\u0443 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430</td><td>\u0421\u0442\u0430\u043D \u0437\u0433\u043E\u0434\u0438, consent ID, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0434\u0430\u043D\u0456, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456 \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438 CMP</td></tr>\\n<tr><td>Calendly, LLC</td><td>\u0412\u0456\u0434\u0436\u0435\u0442/pop-up \u0442\u0430 \u0431\u0440\u043E\u043D\u044E\u0432\u0430\u043D\u043D\u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439</td><td>\u0406\u043C\u2019\u044F, email, \u0434\u0430\u0442\u0430/\u0447\u0430\u0441, \u0447\u0430\u0441\u043E\u0432\u0438\u0439 \u043F\u043E\u044F\u0441, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456 \u0443 \u0444\u043E\u0440\u043C\u0456 \u0431\u0440\u043E\u043D\u044E\u0432\u0430\u043D\u043D\u044F, \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0434\u0430\u043D\u0456</td></tr>\\n<tr><td>\u041F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0438 email, \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u0439\u043D\u0456 \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442\u0438 \u0442\u0430 \u043F\u0456\u0434\u0440\u044F\u0434\u043D\u0438\u043A\u0438</td><td>\u0414\u0456\u043B\u043E\u0432\u0435 \u043B\u0438\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F, \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0456\u044F, \u044E\u0440\u0438\u0434\u0438\u0447\u043D\u0430/\u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0430 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0430</td><td>\u041B\u0438\u0448\u0435 \u0434\u0430\u043D\u0456, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456 \u0434\u043B\u044F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E\u0457 \u043F\u043E\u0441\u043B\u0443\u0433\u0438</td></tr>\\n</tbody></table>\\n\\n<h2>7. \u041C\u0456\u0436\u043D\u0430\u0440\u043E\u0434\u043D\u0456 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0456</h2>\\n<p>Photon Digital \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043E\u0432\u0430\u043D\u0438\u0439 \u0432 \u0423\u043A\u0440\u0430\u0457\u043D\u0456, \u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430 \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0456\u0432 \u0456\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0438 \u043F\u0440\u0430\u0446\u044E\u0454 \u0443 \u0404\u0415\u0417, \u0421\u0428\u0410 \u0442\u0430 \u0456\u043D\u0448\u0438\u0445 \u043A\u0440\u0430\u0457\u043D\u0430\u0445. \u0422\u043E\u043C\u0443 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0456 \u0434\u0430\u043D\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u043E\u0431\u0440\u043E\u0431\u043B\u044F\u0442\u0438\u0441\u044F \u0437\u0430 \u043C\u0435\u0436\u0430\u043C\u0438 \u043A\u0440\u0430\u0457\u043D\u0438 \u0432\u0430\u0448\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u043D\u043D\u044F.</p>\\n<p>\u041A\u043E\u043B\u0438 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F GDPR/UK GDPR, \u043C\u0438 \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0454\u043C\u043E\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043D\u0456 \u0437\u0430\u043A\u043E\u043D\u043E\u043C \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0456, \u0437\u043E\u043A\u0440\u0435\u043C\u0430 \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u043F\u0440\u043E \u0430\u0434\u0435\u043A\u0432\u0430\u0442\u043D\u0456\u0441\u0442\u044C, EU-U.S. Data Privacy Framework / \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u043D\u044F, Standard Contractual Clauses (SCCs) \u0430\u0431\u043E \u0456\u043D\u0448\u0456 \u043D\u0430\u043B\u0435\u0436\u043D\u0456 \u0433\u0430\u0440\u0430\u043D\u0442\u0456\u0457 \u2014 \u0437\u0430\u043B\u0435\u0436\u043D\u043E \u0432\u0456\u0434 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430 \u0442\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u0434\u0430\u043D\u0438\u0445.</p>\\n<p>Calendly \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044F\u0454, \u0449\u043E \u0434\u0430\u043D\u0456 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u0442\u0430 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u0438\u0445 \u043E\u0441\u0456\u0431 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F \u0443 \u0434\u0430\u0442\u0430-\u0446\u0435\u043D\u0442\u0440\u0430\u0445 \u0443 \u0421\u0428\u0410 \u0442\u0430 \u0449\u043E Calendly \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0438\u0439 \u0437\u0430 EU-U.S. Data Privacy Framework. Cloudflare \u0456 Google \u0442\u0430\u043A\u043E\u0436 \u043F\u0443\u0431\u043B\u0456\u043A\u0443\u044E\u0442\u044C \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E DPF/SCC \u0442\u0430 \u0456\u043D\u0448\u0456 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0438 \u043C\u0456\u0436\u043D\u0430\u0440\u043E\u0434\u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u0434\u0430\u0447.</p>\\n<p>\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u043D\u0430 info@photon-digital.com, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0430\u043D\u0438\u0439 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0456.</p>\\n\\n<h2>8. \u0421\u0442\u0440\u043E\u043A\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043D\u043D\u044F</h2>\\n<p>\u0417\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0439\u043D\u0438\u0445 \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432, \u044F\u043A\u0456 \u043D\u0435 \u043F\u0435\u0440\u0435\u0439\u0448\u043B\u0438 \u0443 \u0434\u043E\u0433\u043E\u0432\u0456\u0440\u043D\u0456 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D\u0438: \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0434\u043E 24 \u043C\u0456\u0441\u044F\u0446\u0456\u0432 \u043F\u0456\u0441\u043B\u044F \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457 \u0437\u043C\u0456\u0441\u0442\u043E\u0432\u043D\u043E\u0457 \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457, \u044F\u043A\u0449\u043E \u043D\u0435\u043C\u0430\u0454 \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0457\u0445 \u0434\u043E\u0432\u0448\u0435 \u0430\u0431\u043E \u0432\u0438\u0434\u0430\u043B\u0438\u0442\u0438 \u0440\u0430\u043D\u0456\u0448\u0435.</p>\\n<p>\u0414\u0430\u043D\u0456 \u0447\u0438\u043D\u043D\u0438\u0445/\u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0445 \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432, \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438, \u0440\u0430\u0445\u0443\u043D\u043A\u0438 \u0442\u0430 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u044C\u043A\u0456 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438: \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u0441\u0442\u0440\u043E\u043A\u0443 \u0441\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u0456 \u0442\u0430 \u0434\u0430\u043B\u0456 \u2014 \u0443 \u043C\u0435\u0436\u0430\u0445 \u0441\u0442\u0440\u043E\u043A\u0456\u0432, \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0445 \u0437\u0430 \u043F\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u043C, \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u044C\u043A\u0438\u043C \u0442\u0430 \u0456\u043D\u0448\u0438\u043C \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u043D\u0438\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0432\u0441\u0442\u0432\u043E\u043C \u0430\u0431\u043E \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u044E\u0440\u0438\u0434\u0438\u0447\u043D\u0438\u0445 \u0432\u0438\u043C\u043E\u0433.</p>\\n<p>\u0414\u0430\u043D\u0456 \u043F\u0440\u043E \u0431\u0440\u043E\u043D\u044E\u0432\u0430\u043D\u043D\u044F Calendly: \u0441\u0442\u0456\u043B\u044C\u043A\u0438, \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u043B\u044F \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0457 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456 \u0442\u0430 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0438\u0445 \u0434\u0456\u043B\u043E\u0432\u0438\u0445 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D; Calendly \u043C\u043E\u0436\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0434\u0430\u043D\u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u0432\u043B\u0430\u0441\u043D\u0438\u0445 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u044C \u0456 \u043F\u043E\u043B\u0456\u0442\u0438\u043A\u0438.</p>\\n<p>Google Analytics 4: \u0441\u0442\u0440\u043E\u043A\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043D\u043D\u044F user-level/event-level \u0434\u0430\u043D\u0438\u0445 \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u044E\u0442\u044C\u0441\u044F \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u0440\u0435\u0441\u0443\u0440\u0441\u0443 GA4 (\u0434\u043B\u044F \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 Google \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 2 \u0430\u0431\u043E 14 \u043C\u0456\u0441\u044F\u0446\u0456\u0432). \u0410\u0433\u0440\u0435\u0433\u043E\u0432\u0430\u043D\u0456 \u0437\u0432\u0456\u0442\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u0441\u044F \u0434\u043E\u0432\u0448\u0435. \u041A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0456 \u0441\u0442\u0440\u043E\u043A\u0438 cookies \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0456 \u0443 Cookie Declaration.</p>\\n<p>\u0417\u0430\u043F\u0438\u0441\u0438 \u043F\u0440\u043E \u0437\u0433\u043E\u0434\u0443: \u0441\u0442\u0456\u043B\u044C\u043A\u0438, \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u043E\u0431\u0491\u0440\u0443\u043D\u0442\u043E\u0432\u0430\u043D\u043E \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u0434\u043B\u044F \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F \u0434\u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0432\u0438\u043C\u043E\u0433 \u0449\u043E\u0434\u043E \u0437\u0433\u043E\u0434\u0438 \u0442\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u044C CMP.</p>\\n\\n<h2>9. \u0411\u0435\u0437\u043F\u0435\u043A\u0430 \u0434\u0430\u043D\u0438\u0445</h2>\\n<p>\u041C\u0438 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u043C\u043E \u0440\u043E\u0437\u0443\u043C\u043D\u0456 \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0442\u0430 \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u0439\u043D\u0456 \u0437\u0430\u0445\u043E\u0434\u0438 \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u0440\u0438\u0437\u0438\u043A\u0443, \u0437\u043E\u043A\u0440\u0435\u043C\u0430 HTTPS/TLS, \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0434\u043E\u0441\u0442\u0443\u043F\u0443, \u043F\u0440\u0438\u043D\u0446\u0438\u043F \u043C\u0456\u043D\u0456\u043C\u0430\u043B\u044C\u043D\u043E \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0445 \u043F\u0440\u0430\u0432, \u0431\u0430\u0433\u0430\u0442\u043E\u0444\u0430\u043A\u0442\u043E\u0440\u043D\u0443 \u0430\u0432\u0442\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u044E \u0442\u0430\u043C, \u0434\u0435 \u0432\u043E\u043D\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430, \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043D\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0434\u043E \u043A\u043B\u0456\u0454\u043D\u0442\u0441\u044C\u043A\u0438\u0445 \u0430\u043A\u0430\u0443\u043D\u0442\u0456\u0432 \u0442\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0456\u0432 \u0456\u0437 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u043C\u0438 \u0437\u0430\u0441\u043E\u0431\u0430\u043C\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0443.</p>\\n<p>\u0416\u043E\u0434\u0435\u043D \u0441\u043F\u043E\u0441\u0456\u0431 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0456 \u0430\u0431\u043E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043D\u043D\u044F \u0434\u0430\u043D\u0438\u0445 \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0443\u0454 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0457 \u0431\u0435\u0437\u043F\u0435\u043A\u0438.</p>\\n\\n<h2>10. \u0412\u0430\u0448\u0456 \u043F\u0440\u0430\u0432\u0430</h2>\\n<p>\u0417\u0430\u043B\u0435\u0436\u043D\u043E \u0432\u0456\u0434 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u043D\u043E\u0433\u043E \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043C\u0430\u0442\u0438 \u043F\u0440\u0430\u0432\u043E: \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u0442\u0430 \u043A\u043E\u043F\u0456\u044E \u0441\u0432\u043E\u0457\u0445 \u0434\u0430\u043D\u0438\u0445; \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u043D\u0435\u0442\u043E\u0447\u043D\u0456 \u0434\u0430\u043D\u0456; \u0432\u0438\u043C\u0430\u0433\u0430\u0442\u0438 \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F; \u043E\u0431\u043C\u0435\u0436\u0438\u0442\u0438 \u043E\u0431\u0440\u043E\u0431\u043A\u0443; \u0437\u0430\u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0438 \u043F\u0440\u043E\u0442\u0438 \u043E\u0431\u0440\u043E\u0431\u043A\u0438, \u0449\u043E \u0491\u0440\u0443\u043D\u0442\u0443\u0454\u0442\u044C\u0441\u044F \u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C\u0443 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0456; \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0434\u0430\u043D\u0456 \u0443 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u043C\u043E\u043C\u0443 \u0444\u043E\u0440\u043C\u0430\u0442\u0456, \u043A\u043E\u043B\u0438 \u0446\u0435 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u043D\u043E; \u0432\u0456\u0434\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0437\u0433\u043E\u0434\u0443 \u0431\u0435\u0437 \u0432\u043F\u043B\u0438\u0432\u0443 \u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u043D\u0456\u0441\u0442\u044C \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u044C\u043E\u0457 \u043E\u0431\u0440\u043E\u0431\u043A\u0438; \u043F\u043E\u0434\u0430\u0442\u0438 \u0441\u043A\u0430\u0440\u0433\u0443 \u0434\u043E \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0442\u043D\u043E\u0433\u043E \u043D\u0430\u0433\u043B\u044F\u0434\u043E\u0432\u043E\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0443.</p>\\n<p>\u0414\u043B\u044F \u0440\u0435\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0457 \u043F\u0440\u0430\u0432 \u043D\u0430\u043F\u0438\u0448\u0456\u0442\u044C \u043D\u0430 info@photon-digital.com. \u041C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0438 \u043C\u0456\u043D\u0456\u043C\u0430\u043B\u044C\u043D\u0443 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u0434\u043B\u044F \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F \u043E\u0441\u043E\u0431\u0438. \u0417\u0430\u043F\u0438\u0442\u0438 \u0440\u043E\u0437\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u0443 \u0441\u0442\u0440\u043E\u043A\u0438, \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0456 \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u043D\u0438\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u043C (\u0437\u0430 GDPR \u2014 \u044F\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u043E\u0434\u043D\u043E\u0433\u043E \u043C\u0456\u0441\u044F\u0446\u044F).</p>\\n<p>\u0412 \u0423\u043A\u0440\u0430\u0457\u043D\u0456 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0437\u0456 \u0441\u043A\u0430\u0440\u0433\u043E\u044E \u0434\u043E \u0423\u043F\u043E\u0432\u043D\u043E\u0432\u0430\u0436\u0435\u043D\u043E\u0433\u043E \u0412\u0435\u0440\u0445\u043E\u0432\u043D\u043E\u0457 \u0420\u0430\u0434\u0438 \u0423\u043A\u0440\u0430\u0457\u043D\u0438 \u0437 \u043F\u0440\u0430\u0432 \u043B\u044E\u0434\u0438\u043D\u0438 \u0430\u0431\u043E \u0434\u043E \u0441\u0443\u0434\u0443. \u042F\u043A\u0449\u043E GDPR \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F \u0434\u043E \u0432\u0430\u0448\u043E\u0457 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457, \u0432\u0438 \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E \u043D\u0430\u0433\u043B\u044F\u0434\u043E\u0432\u043E\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0443 \u0443 \u0434\u0435\u0440\u0436\u0430\u0432\u0456 \u0404\u0415\u0417 \u0432\u0430\u0448\u043E\u0433\u043E \u043F\u0440\u043E\u0436\u0438\u0432\u0430\u043D\u043D\u044F, \u0440\u043E\u0431\u043E\u0442\u0438 \u0430\u0431\u043E \u0439\u043C\u043E\u0432\u0456\u0440\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0443\u0448\u0435\u043D\u043D\u044F.</p>\\n\\n<h2>11. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u043E\u0432\u0430\u043D\u0456 \u0440\u0456\u0448\u0435\u043D\u043D\u044F</h2>\\n<p>Photon Digital \u043D\u0435 \u043F\u0440\u0438\u0439\u043C\u0430\u0454 \u0449\u043E\u0434\u043E \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456\u0432 \u0441\u0430\u0439\u0442\u0443 \u0430\u0431\u043E \u043E\u0441\u0456\u0431, \u044F\u043A\u0456 \u0437\u0432\u0435\u0440\u0442\u0430\u044E\u0442\u044C\u0441\u044F \u0434\u043E \u043D\u0430\u0441, \u0440\u0456\u0448\u0435\u043D\u044C, \u0449\u043E \u0491\u0440\u0443\u043D\u0442\u0443\u044E\u0442\u044C\u0441\u044F \u0432\u0438\u043A\u043B\u044E\u0447\u043D\u043E \u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u043E\u0432\u0430\u043D\u0456\u0439 \u043E\u0431\u0440\u043E\u0431\u0446\u0456 \u0442\u0430 \u043C\u0430\u044E\u0442\u044C \u044E\u0440\u0438\u0434\u0438\u0447\u043D\u0456 \u0430\u0431\u043E \u043F\u043E\u0434\u0456\u0431\u043D\u0456 \u0456\u0441\u0442\u043E\u0442\u043D\u0456 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0438 \u0443 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u0456 GDPR Art. 22.</p>\\n\\n<h2>12. \u0414\u0430\u043D\u0456 \u0434\u0456\u0442\u0435\u0439</h2>\\n<p>\u0421\u0430\u0439\u0442 \u0456 \u043F\u043E\u0441\u043B\u0443\u0433\u0438 Photon Digital \u043E\u0440\u0456\u0454\u043D\u0442\u043E\u0432\u0430\u043D\u0456 \u043D\u0430 \u0431\u0456\u0437\u043D\u0435\u0441 \u0456 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u043B\u044F \u0434\u0456\u0442\u0435\u0439. \u041C\u0438 \u0441\u0432\u0456\u0434\u043E\u043C\u043E \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u0454\u043C\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0456 \u0434\u0430\u043D\u0456 \u0434\u0456\u0442\u0435\u0439 \u0447\u0435\u0440\u0435\u0437 \u0446\u0435\u0439 \u0441\u0430\u0439\u0442. \u042F\u043A\u0449\u043E \u0432\u0438 \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u0435, \u0449\u043E \u0434\u0438\u0442\u0438\u043D\u0430 \u043D\u0430\u0434\u0430\u043B\u0430 \u043D\u0430\u043C \u0434\u0430\u043D\u0456, \u043D\u0430\u043F\u0438\u0448\u0456\u0442\u044C \u043D\u0430 info@photon-digital.com.</p>\\n\\n<h2>13. \u041F\u0440\u043E\u0434\u0430\u0436 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0430\u043D\u0438\u0445 \u0456 \u0440\u043E\u0437\u0441\u0438\u043B\u043A\u0438</h2>\\n<p>\u041C\u0438 \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0454\u043C\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u0456 \u0434\u0430\u043D\u0456. \u041D\u0430 \u043C\u043E\u043C\u0435\u043D\u0442 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E \u043E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0446\u044F \u0444\u043E\u0440\u043C\u0430 \u0441\u0430\u0439\u0442\u0443 \u043D\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F \u0434\u043B\u044F \u043F\u0456\u0434\u043F\u0438\u0441\u043A\u0438 \u043D\u0430 \u043C\u0430\u0441\u043E\u0432\u0443 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u0432\u0443 email-\u0440\u043E\u0437\u0441\u0438\u043B\u043A\u0443. \u042F\u043A\u0449\u043E \u0442\u0430\u043A\u0430 \u0440\u043E\u0437\u0441\u0438\u043B\u043A\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u043F\u0440\u043E\u0432\u0430\u0434\u0436\u0435\u043D\u0430, \u0434\u043B\u044F \u043D\u0435\u0457 \u0431\u0443\u0434\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0443 \u043F\u0440\u0430\u0432\u043E\u0432\u0443 \u043F\u0456\u0434\u0441\u0442\u0430\u0432\u0443 \u0442\u0430 \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C \u0432\u0456\u0434\u043C\u043E\u0432\u0438.</p>\\n\\n<h2>14. \u0417\u043C\u0456\u043D\u0438 \u0434\u043E \u041F\u043E\u043B\u0456\u0442\u0438\u043A\u0438</h2>\\