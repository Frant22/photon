0437 \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0438\u043C\u0438 \u0444\u0430\u0445\u0456\u0432\u0446\u044F\u043C\u0438","description":"\u041C\u0438 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u0456\u0437\u0443\u0454\u043C\u043E\u0441\u044F \u043D\u0430 \u043F\u043B\u0430\u0442\u043D\u0456\u0439 \u0440\u0435\u043A\u043B\u0430\u043C\u0456, \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u0446\u0456 \u0442\u0430 \u043A\u043E\u043D\u0432\u0435\u0440\u0441\u0456\u044F\u0445. \u0417\u043D\u0430\u0445\u043E\u0434\u0438\u043C\u043E, \u0434\u0435 \u0431\u044E\u0434\u0436\u0435\u0442 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454\u0442\u044C\u0441\u044F \u043D\u0435\u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E, \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0454\u043C\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u0438 \u0434\u043B\u044F \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0456\u0432 \u0456 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0454\u043C\u043E \u043A\u0430\u043C\u043F\u0430\u043D\u0456\u0457, \u044F\u043A\u0456 \u0434\u0430\u044E\u0442\u044C \u0440\u0435\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u0456\u0437\u043D\u0435\u0441-\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.","cta":"\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u043C\u0456\u0439 \u0430\u043A\u0430\u0443\u043D\u0442"},"about":{"founder":{"name":"\u0411\u043E\u0440\u0438\u0441 \u041A\u0443\u0437\u044C\u043C\u0435\u043D\u044E\u043A","role":"\u0417\u0430\u0441\u043D\u043E\u0432\u043D\u0438\u043A \u0456 Senior PPC Manager","quote1":"\u042F \u043E\u0446\u0456\u043D\u044E\u044E PPC \u043D\u0435 \u0437\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u0438\u043C \u0437\u0432\u0456\u0442\u043E\u043C, \u0430 \u0437\u0430 \u044F\u043A\u0456\u0441\u0442\u044E \u043B\u0456\u0434\u0456\u0432, \u043F\u0440\u043E\u0434\u0430\u0436\u0430\u043C\u0438 \u0442\u0430 \u0434\u043E\u0445\u043E\u0434\u043E\u043C, \u044F\u043A\u0456 \u0440\u0435\u043A\u043B\u0430\u043C\u0430 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0431\u0456\u0437\u043D\u0435\u0441\u0443.","quote2":"\u041C\u043E\u0454 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u2014 \u0437\u043D\u0430\u0439\u0442\u0438, \u0434\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u0454\u0442\u044C\u0441\u044F \u0431\u044E\u0434\u0436\u0435\u0442, \u043D\u0430\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F \u0442\u0430 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0432\u0430\u0442\u0438 \u0442\u0435, \u0449\u043E \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043F\u0440\u0430\u0446\u044E\u0454."},"title":"\u0412\u0430\u0448 \u0430\u043A\u0430\u0443\u043D\u0442 \u0432\u0435\u0434\u0443\u0442\u044C \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0456 PPC-\u0444\u0430\u0445\u0456\u0432\u0446\u0456 \u2014 \u0432\u0456\u0434 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0434\u043E \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0430\u0446\u0456\u0457","description":"\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044F, \u0430\u043D\u0430\u043B\u0456\u0442\u0438\u043A\u0430 \u0442\u0430 \u043A\u043B\u044E\u0447\u043E\u0432\u0456 \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F \u0437\u0430 \u0444\u0430\u0445\u0456\u0432\u0446\u044F\u043C\u0438, \u044F\u043A\u0456 \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C \u0437 \u0430\u043A\u0430\u0443\u043D\u0442\u043E\u043C. \u0412\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0442\u0435, \u0449\u043E \u043C\u0438 \u0437\u043C\u0456\u043D\u044E\u0454\u043C\u043E, \u043D\u0430\u0432\u0456\u0449\u043E \u0446\u0435 \u0440\u043E\u0431\u0438\u043C\u043E \u0456 \u044F\u043A \u0446\u0435 \u043C\u0430\u0454 \u0432\u043F\u043B\u0438\u043D\u0443\u0442\u0438 \u043D\u0430 CPA, ROAS, \u044F\u043A\u0456\u0441\u0442\u044C \u043B\u